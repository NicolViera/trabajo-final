{
  "name": "chic-rose-api",
  "version": "1.0.0",
  "description": "API Backend para Chic Rose con Prisma + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node prisma/seed.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:studio": "npx prisma studio",
    "setup": "npm install && npx prisma migrate dev --name init && node prisma/seed.js"
  },
  "keywords": [
    "chic-rose",
    "api",
    "prisma",
    "express"
  ],
  "author": "Chic Rose",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "prisma": "^5.22.0"
  }
}
